# ============================================
# SERVER CONFIGURATION
# ============================================

# Environment: development | production | test
NODE_ENV=development

# Server port (default: 5000)
PORT=5000

# Server base URL (used for OAuth callbacks and email links)
SERVER_URL=http://localhost:5000

# ============================================
# DATABASE CONFIGURATION
# ============================================

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/ctc-club
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/ctc-club?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ctc-club

# ============================================
# JWT AUTHENTICATION
# ============================================

# JWT secret key (MUST be changed in production!)
# Generate with: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-characters

# JWT token expiration (examples: 1h, 7d, 30d, 90d)
JWT_EXPIRES_IN=30d

# ============================================
# CORS CONFIGURATION
# ============================================

# Primary client URL (frontend application)
CLIENT_URL=http://localhost:5173

# Additional allowed origins (comma-separated, no spaces)
# Example: http://localhost:3000,https://ctcclub.com,https://www.ctcclub.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# RATE LIMITING
# ============================================

# General API endpoints (requests per 15 minutes)
RATE_LIMIT_MAX=500

# Authentication endpoints (requests per 15 minutes)
# Stricter limit to prevent brute force attacks
AUTH_RATE_LIMIT_MAX=20

# ============================================
# FILE UPLOAD LIMITS
# ============================================

# Maximum video upload size in MB
VIDEO_UPLOAD_MAX_MB=512

# Maximum resource/document upload size in MB
RESOURCE_UPLOAD_MAX_MB=50

# ============================================
# PASSWORD RESET
# ============================================

# Password reset code expiration time in minutes
PASSWORD_RESET_CODE_TTL_MINUTES=10

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
# Required for password reset and notifications

# SMTP server host (examples: smtp.gmail.com, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP username (usually your email address)
SMTP_USER=your-email@gmail.com

# SMTP password (use App Password for Gmail)
# Gmail: https://support.google.com/accounts/answer/185833
SMTP_PASS=your-app-password

# Email sender address and name
SMTP_FROM=CTC Club <noreply@ctcclub.com>

# ============================================
# OAUTH PROVIDERS (Optional)
# ============================================

# Google OAuth 2.0
# Get credentials: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/oauth/google/callback

# GitHub OAuth
# Get credentials: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/oauth/github/callback

# ============================================
# PAYMENT GATEWAY - CHAPA (Optional)
# ============================================
# Required only if enabling payment features

# Chapa secret key (get from: https://dashboard.chapa.co)
CHAPA_SECRET_KEY=your-chapa-secret-key

# Chapa webhook secret for verifying webhook authenticity
CHAPA_WEBHOOK_SECRET=your-webhook-secret

# Chapa API base URL
CHAPA_API_BASE_URL=https://api.chapa.co/v1

# Premium subscription price in Ethiopian Birr (ETB)
PREMIUM_PRICE_ETB=200

# Payment return URLs (where users are redirected after payment)
CHAPA_RETURN_URL=http://localhost:5173/payment/success
CHAPA_COURSE_RETURN_URL=http://localhost:5173/payment/course/success
CHAPA_CALLBACK_URL=http://localhost:5000/api/payments/webhook

# ============================================
# CLOUDINARY (Optional)
# ============================================
# For cloud-based file storage (alternative to local uploads)

# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# AWS S3 (Optional)
# ============================================
# For cloud-based file storage (alternative to local uploads)

# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=ctc-club-uploads

# ============================================
# LOGGING (Optional)
# ============================================

# Log level: error | warn | info | debug
# LOG_LEVEL=info

# ============================================
# REDIS (Optional)
# ============================================
# For caching and session storage

# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# ============================================
# MONITORING (Optional)
# ============================================

# Sentry DSN for error tracking
# SENTRY_DSN=your-sentry-dsn

# ============================================
# NOTES
# ============================================
# 1. Copy this file to .env and fill in your values
# 2. NEVER commit .env to version control
# 3. Generate strong, unique secrets for production
# 4. Use environment-specific values for each deployment
# 5. Required fields: NODE_ENV, PORT, MONGO_URI, JWT_SECRET, CLIENT_URL
# 6. Optional fields can be left empty if features aren't used
