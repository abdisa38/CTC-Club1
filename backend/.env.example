NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ctc-club
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20
SERVER_URL=http://localhost:5000
PASSWORD_RESET_CODE_TTL_MINUTES=10
VIDEO_UPLOAD_MAX_MB=512
RESOURCE_UPLOAD_MAX_MB=50

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP (required for password reset email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Chapa payments (optional unless payment features are enabled)
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_API_BASE_URL=
PREMIUM_PRICE_ETB=200
CHAPA_RETURN_URL=
CHAPA_COURSE_RETURN_URL=
CHAPA_CALLBACK_URL=
