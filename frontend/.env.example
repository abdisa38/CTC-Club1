# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================

# ============================================
# API CONFIGURATION
# ============================================

# Backend API base URL
# Development (same origin): Leave empty or use /api
# Production (different domain): https://api.ctcclub.com/api
VITE_API_BASE_URL=

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Application name (displayed in browser tab and meta tags)
VITE_APP_NAME=CTC Club

# Application URL (used for social sharing and SEO)
VITE_APP_URL=http://localhost:5173

# ============================================
# FEATURE FLAGS (Optional)
# ============================================

# Enable/disable features
# VITE_ENABLE_PAYMENTS=true
# VITE_ENABLE_OAUTH=true
# VITE_ENABLE_ANALYTICS=false

# ============================================
# ANALYTICS (Optional)
# ============================================

# Google Analytics tracking ID
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# ============================================
# ERROR TRACKING (Optional)
# ============================================

# Sentry DSN for frontend error tracking
# VITE_SENTRY_DSN=your-sentry-dsn

# ============================================
# NOTES
# ============================================
# 1. Copy this file to .env for local development
# 2. All VITE_ prefixed variables are exposed to the client
# 3. NEVER put sensitive data in frontend environment variables
# 4. Variables are embedded at build time, not runtime
# 5. Restart dev server after changing environment variables
